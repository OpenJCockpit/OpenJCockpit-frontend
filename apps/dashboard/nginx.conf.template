server {
  include /etc/nginx/conf.d/listen.inc;
  server_name _;

  root /usr/share/nginx/html;

  gzip on;
  gzip_vary on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

  # Vite emits content-hashed filenames under /assets/, so they can be cached forever.
  location /assets/ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # The entry document references the hashed assets and must always be revalidated.
  location = /index.html {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache";
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location / {
    include /etc/nginx/conf.d/security-headers.inc;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }

  # Rendered from the container env so one image works for every environment; the app reads it before Keycloak init.
  location = /config.json {
    include /etc/nginx/conf.d/security-headers.inc;
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"keycloak":{"url":"${KEYCLOAK_URL}","realm":"${KEYCLOAK_REALM}","clientId":"${KEYCLOAK_CLIENT_ID}"},"federation":{"allowedOrigins":${FEDERATION_ALLOWED_ORIGINS_JSON}}}';
  }

  # Remotes the hub loads, rendered from the container env (a JSON object of name to mf-manifest.json URL).
  # Overrides the localhost dev manifest in public/. Adding an app is an env change, not a host rebuild.
  location = /federation.manifest.json {
    include /etc/nginx/conf.d/security-headers.inc;
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '${FEDERATION_MANIFEST}';
  }

  # Build identity for support and deploy checks; set with `--build-arg BUILD_SHA=<git sha>`.
  location = /version.json {
    include /etc/nginx/conf.d/security-headers.inc;
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"sha":"${BUILD_SHA}"}';
  }

  # The federated remotes are served under this origin: /remotes/<name>/ goes to http://<prefix><name>:<port>/ (their
  # images are built with base /remotes/<name>/), so the browser needs no extra origin, CORS or certificate. The remote's
  # own nginx sets the Cache-Control (no-store manifest, immutable chunks). Adding an app is a new remote container,
  # not a dashboard change. The upstream is a variable and the resolver re-resolves it, so the dashboard starts before
  # the remotes exist and follows their address changes.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

  location ~ ^/remotes/([a-z0-9-]+)/(.*)$ {
    set $remote_host ${REMOTE_HOST_PREFIX}$1;
    proxy_pass http://$remote_host:${REMOTE_PORT}/$2$is_args$args;
  }

  # The upstream is a variable (re-resolved via the resolver above), so a backend that is not up yet is a 502 on /api
  # rather than a dashboard that refuses to start. Without a URI part the request URI (/api/...) is passed unchanged.
  location /api/ {
    include /etc/nginx/conf.d/security-headers.inc;
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    # Spec listing and spec init run a git clone/push synchronously (max 120s each);
    # the nginx default of 60s would abort those requests with a gateway error.
    proxy_connect_timeout 10s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
  }
}
