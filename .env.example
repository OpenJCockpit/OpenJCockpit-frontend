# Optional overrides for docker-compose.yml. Defaults assume the backend stack runs on this machine
# (backend repository: `docker compose up -d`), publishing ai-control-service on 9080 and Keycloak on 8080.

# Where the dashboard's nginx proxies /api (server-side, resolved from inside the container).
# API_UPSTREAM=http://host.docker.internal:9080

# Where the browser logs in (must be reachable from the browser, and match the realm's redirect URIs).
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=openjcockpit
# KEYCLOAK_CLIENT_ID=openjcockpit

# TLS (docker-compose.tls.yml, see docs/tls.md)
# PUBLIC_HOST=localhost
# TLS_CERT_DIR=./certs
