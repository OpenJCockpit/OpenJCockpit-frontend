# Optional overrides for docker-compose.yml. Defaults assume the backend stack runs on this machine
# (backend repository: `docker compose up -d`), publishing ai-control-service on 9080 and Keycloak on 8080.

# Where the dashboard's nginx proxies /api (server-side, resolved from inside the container).
# API_UPSTREAM=http://host.docker.internal:9080

# Where the dashboard's nginx proxies /controltower-api (as /api on the ControlTower backend, published on 9180).
# CONTROLTOWER_UPSTREAM=http://host.docker.internal:9180

# Run without ControlTower: uncomment the five-remote manifest and start every service but remote-controltower.
# CONTROLTOWER_UPSTREAM can stay unset. See README, "Running without ControlTower".
# FEDERATION_MANIFEST={"projects":"/remotes/projects/mf-manifest.json","skillsHub":"/remotes/skills-hub/mf-manifest.json","specs":"/remotes/specs/mf-manifest.json","evidence":"/remotes/evidence/mf-manifest.json","quality":"/remotes/quality/mf-manifest.json"}

# Where the browser logs in (must be reachable from the browser, and match the realm's redirect URIs).
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=openjcockpit
# KEYCLOAK_CLIENT_ID=openjcockpit

# TLS (docker-compose.tls.yml, see docs/tls.md)
# PUBLIC_HOST=localhost
# TLS_CERT_DIR=./certs
