# Node
node_modules/
dist/

# IDE
.idea/
*.iml

# Env
.env
!.env.example

# OS
.DS_Store

# TypeScript incremental build info
*.tsbuildinfo

# Playwright e2e harness (e2e/) — storage state contains live Keycloak SSO
# cookies, and report/artifact directories can contain bearer tokens (see
# e2e/README.md). Never commit any of these.
e2e/.auth/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# Nx local cache and workspace data
.nx/cache
.nx/workspace-data

# Vite cache
.vite/

# PR description scratch files
PR_*.md

# Generated by typed-scss-modules (npm run typings)
*.module.scss.d.ts

# Test coverage reports
coverage/
.playwright-mcp/

# Backend checkout used by CI for the REST contract and the e2e stack
.backend/

# TLS material for docker-compose.tls.yml
certs/
