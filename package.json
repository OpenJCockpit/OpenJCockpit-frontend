{
  "name": "openjcockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "typings": "typed-scss-modules \"{libs,apps}/**/*.module.scss\" --exportType default --nameFormat camel --logLevel error",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "coverage": "nx run-many -t coverage",
    "build": "nx run dashboard:build",
    "check": "nx run-many -t lint typecheck test format-check check-styles check-i18n",
    "affected": "nx affected -t lint typecheck test build",
    "start:hub": "nx run-many -t dev -p dashboard,remote-skills-hub,remote-specs,remote-evidence,remote-quality,remote-controltower,remote-projects --parallel=8",
    "start:hub:core": "HUB_WITHOUT=controltower nx run-many -t dev -p dashboard,remote-skills-hub,remote-specs,remote-evidence,remote-quality,remote-projects --parallel=6",
    "start:hub:mock": "MOCK_API=1 nx run-many -t dev -p dashboard,remote-skills-hub,remote-specs,remote-evidence,remote-quality,remote-controltower,remote-projects --parallel=8",
    "build:hub": "nx run-many -t build -p remote-skills-hub,remote-specs,remote-evidence,remote-quality,remote-controltower,remote-projects,dashboard",
    "trivy": "scripts/trivy-scan.sh",
    "trivy:fs": "scripts/trivy-scan.sh fs",
    "knip": "knip"
  },
  "overrides": {
    "nx": {
      "undici": "7.30.1"
    },
    "@module-federation/dts-plugin": {
      "undici": "7.30.1"
    }
  },
  "nx": {
    "includedScripts": [
      "typings"
    ]
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "e2e"
  ],
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@module-federation/vite": "1.24.1",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "knip": "6.48.0",
    "nx": "24.0.6",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.108.2",
    "typed-scss-modules": "8.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-axe": "0.1.0"
  }
}
